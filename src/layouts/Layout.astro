---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/cinzel';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.company.name} | Private Investigation Services in South Florida`,
  description = `${siteConfig.company.name} provides discreet, professional private investigation services serving ${siteConfig.company.coverageArea}.`,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b213f" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph: pendiente completar og:url/og:image reales cuando haya dominio y assets exportados de Figma -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
  </head>
  <body>
    <slot />
  </body>
</html>
