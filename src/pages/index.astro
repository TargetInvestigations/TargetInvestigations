---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import ContactCta from '../components/ContactCta.astro';
import FaqPanel from '../components/FaqPanel.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />

  <main id="top">
    <Section tone="dark" id="hero" aria-label="Hero">
      <Hero />
    </Section>

    <Section tone="dark" id="services" aria-label="Services">
      <Container size="default">
        <Services />
      </Container>
    </Section>

    <Section tone="dark" id="about" aria-label="About">
      <Container size="default">
        <About />
      </Container>
    </Section>

    <Section tone="dark" aria-label="Frequently asked questions">
      <FaqPanel />
    </Section>

    <Section tone="dark" id="contact" aria-label="Contact">
      <Container size="narrow">
        <ContactCta />
      </Container>
    </Section>
  </main>

  <Footer />
</Layout>

<style>
  /* :global() es necesario: estas secciones son el elemento raíz que renderiza
     <Section>, no marcado escrito directamente en este archivo, así que el scoping
     por defecto de Astro no las alcanza (se comprobó que el atributo data-astro-cid
     de <section> es el de Section.astro, no el de index.astro). */

  /* El <section> que envuelve al Hero tenía SU PROPIO padding-block genérico
     (`.section` en Section.astro, clamp(3rem,6vw,6rem)) además del padding que ya
     maneja `.hero` — eso dejaba una franja de navy plano entre el navbar y la foto
     arriba, y entre la foto/badges y la línea divisoria abajo, en desktop Y mobile.
     El Hero controla su propio espaciado por completo (padding-top propio en mobile
     para el lockup, min-height + capas absolutas en desktop), así que el <section>
     que lo envuelve no debe aportar padding adicional. */
  :global(#hero) {
    padding-block: 0;
  }

  /* Línea entre Hero y Services: en mobile (nodo real `Rectangle 28`, 399:440) es un
     degradado navy→dorado (al centro)→navy que se difumina hacia los extremos —
     mismo estilo que la línea de abajo. En desktop (nodo 185:815) es sólida, sin
     degradado — sí es una diferencia real entre breakpoints, no un descuido. */
  :global(#services) {
    border-top: 4px solid transparent;
    border-image: linear-gradient(to right, var(--color-bg) 0%, #836e47 51%, var(--color-bg) 100%) 1;
  }

  @media (min-width: 1024px) {
    :global(#services) {
      border-top: 2px solid var(--color-gold-light);
      border-image: none;
    }
  }

  /* Línea entre Services y About (nodo 227:1136): degradado navy→dorado (al centro)→navy,
     distinta de la línea sólida de arriba — se "apaga" hacia los extremos. */
  :global(#about) {
    border-top: 4px solid transparent;
    border-image: linear-gradient(to right, var(--color-bg) 0%, var(--color-gold) 50%, var(--color-bg) 100%) 1;
    /* Fondo radial propio de esta sección (nodo 322:1221 en Figma), distinto del navy
       plano del resto de secciones oscuras. */
    background: radial-gradient(140% 100% at 85% 0%, #0d2743 0%, #021124 100%);
  }

</style>
