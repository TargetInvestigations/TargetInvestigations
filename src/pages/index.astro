---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import ValueBadges from '../components/ValueBadges.astro';
import StatBadges from '../components/StatBadges.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
---

<!--
  Fase 2 (Design System): vitrina de componentes reutilizables para verificar que
  funcionan correctamente en ambos breakpoints. Esto NO es el Home real — el
  ensamblado final de Hero/Services/About con el contenido y las fotos completas
  se hace en la Fase 3.
-->
<Layout>
  <Header />

  <main id="top">
    <Section tone="dark" aria-label="Design system preview: value badges">
      <Container size="wide">
        <ValueBadges />
      </Container>
    </Section>

    <Section tone="light" id="about" aria-label="Design system preview: stat badges">
      <Container size="default">
        <StatBadges />
      </Container>
    </Section>

    <Section tone="dark" id="services" aria-label="Design system preview: FAQ accordion">
      <Container size="narrow">
        <h2 style="font-family: var(--font-display); margin-bottom: 1rem;">FAQs</h2>
        <FaqAccordion />
      </Container>
    </Section>

    <Section tone="dark" id="contact" aria-label="Design system preview: placeholder">
      <Container size="narrow">
        <p style="text-align:center; opacity: 0.7;">
          {siteConfig.company.tagline} — Home real en Fase 3.
        </p>
      </Container>
    </Section>
  </main>

  <Footer />
</Layout>
