---
/**
 * Panel de FAQs (nodo 200:876/200:872 en Figma, dentro de "Group 39"). Colapsado por
 * defecto (barra dorada clara "FAQs" + flecha) — al hacer click (ON_CLICK real de
 * Figma) se despliega un tablero de 20 preguntas en 5 filas x 4 columnas sobre un
 * fondo dorado más oscuro (--color-gold, no --color-gold-light), con separadores
 * verticales dorados entre columnas. Cada pregunta revela su respuesta (itálica,
 * blanca) al pasar el mouse (interacción ON_HOVER real de cada tarjeta, nodo 216:384).
 *
 * Las 20 preguntas son contenido real del cliente (ver CLAUDE.md), incluidas tarifas
 * reales. Se agrupan en filas de 4 para reproducir el tablero real; en mobile (donde
 * Figma no define un estado abierto explícito) se apilan en una sola columna dentro
 * de cada fila — decisión de responsive propia, documentada en CLAUDE.md.
 */
import { faqs } from '../data/faqs';

// Cada pregunta va numerada en Figma ("1. How much does…"); se agrupan en filas de 4.
const numbered = faqs.map((item, i) => ({ ...item, q: `${i + 1}. ${item.q}` }));
const rows = [];
for (let i = 0; i < numbered.length; i += 4) rows.push(numbered.slice(i, i + 4));
---

<details class="faq-panel">
  <summary class="faq-panel__summary">
    <div class="faq-panel__summary-inner">
      <h2 class="faq-panel__title">FAQs</h2>
      <!-- Polygon 1 (200:866): "V" abierta — dos trazos navy de 6px con puntas y base
           redondeadas (path exportado tal cual de Figma, no un triángulo cerrado). -->
      <svg class="faq-panel__chevron" viewBox="0 0 34 27" aria-hidden="true">
        <path
          d="M3.017 3.017 13.516 21.201c1.548 2.682 5.419 2.682 6.968 0L30.982 3.017"
          fill="none"
          stroke="currentColor"
          stroke-width="6.034"
          stroke-linecap="round"
        ></path>
      </svg>
    </div>
  </summary>

  <div class="faq-panel__grid">
    <div class="faq-panel__grid-inner">
      {rows.map((row) => (
        <div class="faq-row">
          {row.map((item) => (
            <div class="faq-item">
              <button type="button" class="faq-item__question">
                {item.q}
              </button>
              <div class="faq-item__answer-wrap">
                <p class="faq-item__answer">{item.a}</p>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</details>

<style>
  .faq-panel {
    --u: 1px;
    container-type: inline-size;
    width: 100%;
  }

  .faq-panel__summary {
    display: flex;
    cursor: pointer;
    list-style: none;
    background: var(--color-gold-light);
    transition: background-color 0.2s ease;
  }

  .faq-panel__summary::-webkit-details-marker {
    display: none;
  }

  .faq-panel__summary:focus-visible {
    outline: 2px solid var(--color-bg);
    outline-offset: -6px;
  }

  .faq-panel[open] .faq-panel__summary {
    background: var(--color-gold);
  }

  .faq-panel__summary-inner {
    width: 100%;
    max-width: 68.125rem;
    margin-inline: auto;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .faq-panel__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    color: var(--color-bg);
  }

  .faq-panel__chevron {
    flex-shrink: 0;
    width: 1.25rem;
    height: auto;
    color: var(--color-bg);
    transition: transform 0.25s ease;
  }

  /* Abierto: la flecha rota exactamente 180° (rotación real de las dos variantes). */
  .faq-panel[open] .faq-panel__chevron {
    transform: rotate(180deg);
  }

  .faq-panel__grid {
    background: var(--color-gold);
  }

  .faq-panel__grid-inner {
    width: 100%;
    max-width: 68.125rem;
    margin-inline: auto;
    padding: 0 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.8125rem;
  }

  .faq-row {
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1.25rem;
  }

  .faq-item {
    padding-block: 0.875rem;
  }

  .faq-item:not(:first-child) {
    border-top: 1px solid rgba(233, 195, 126, 0.3);
  }

  /* Pregunta: Inter SemiBold 13px/19.5px #E9C37E. */
  .faq-item__question {
    all: unset;
    display: block;
    cursor: pointer;
    width: 100%;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: calc(var(--u) * 13);
    line-height: calc(var(--u) * 19.5);
    color: var(--color-gold-light);
  }

  .faq-item__question:focus-visible {
    outline: 1px solid var(--color-gold-light);
    outline-offset: 3px;
  }

  /* Respuesta: Inter Medium Italic 13px/19.5px blanca, 12px debajo de la pregunta;
     aparece en hover/focus (ON_HOVER → CHANGE_TO de cada tarjeta, p. ej. 216:351). */
  .faq-item__answer-wrap {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.25s ease,
      opacity 0.2s ease;
  }

  .faq-item__answer-wrap > .faq-item__answer {
    overflow: hidden;
    margin: 0;
    padding-top: calc(var(--u) * 12);
    font-family: var(--font-body);
    font-weight: 500;
    font-style: italic;
    font-size: calc(var(--u) * 13);
    line-height: calc(var(--u) * 19.5);
    color: var(--color-white);
  }

  .faq-item:hover .faq-item__answer-wrap,
  .faq-item:focus-within .faq-item__answer-wrap {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /* --- Desktop (≥1024px): medidas del componente Group 39 (200:870 cerrado /
       200:872 abierto) en unidades del frame de 1549px — escala por encima de ese
       ancho, como el resto de secciones. --- */
  @media (min-width: 1024px) {
    .faq-panel {
      --u: max(1px, 100cqi / 1549);
    }

    /* Cerrado: barra de 117px, "FAQs" Fraunces SemiBold 44px/52.8px navy y triángulo
           en los extremos de una caja de 1081px. Abierto: el título baja a 34px del borde
           superior y las filas empiezan 57px debajo. */
    .faq-panel__summary-inner {
      max-width: min(calc(var(--u) * 1081), 100% - 3rem);
      padding: calc(var(--u) * 32) 0;
    }

    .faq-panel[open] .faq-panel__summary-inner {
      padding: calc(var(--u) * 34) 0 0;
    }

    .faq-panel__title {
      font-size: calc(var(--u) * 44);
      line-height: calc(var(--u) * 52.8);
    }

    /* Caja de render del vector en Figma: 34×26. */
    .faq-panel__chevron {
      width: calc(var(--u) * 34);
    }

    /* Tablero: filas de 1090px separadas 13px; 56px de aire al final. */
    .faq-panel__grid-inner {
      max-width: min(calc(var(--u) * 1090), 100% - 3rem);
      padding: calc(var(--u) * 57) 0 calc(var(--u) * 56);
      gap: calc(var(--u) * 13);
    }

    /* Cada fila (Frame 75…99): padding 24/50/3 (13 abajo en la primera), tarjetas de
           196px centradas con 30px + línea + 30px entre ellas. */
    .faq-row {
      flex-direction: row;
      justify-content: center;
      padding: calc(var(--u) * 24) calc(var(--u) * 50) calc(var(--u) * 3);
      gap: calc(var(--u) * 60);
    }

    .faq-row:first-child {
      padding-bottom: calc(var(--u) * 13);
    }

    .faq-item {
      flex: none;
      width: calc(var(--u) * 196);
      padding-block: 0;
      position: relative;
    }

    .faq-item:not(:first-child) {
      border-top: none;
    }

    /* Separador (Line 23…31): 1px #E9C37E, 53px de alto desde el borde superior. */
    .faq-item:not(:first-child)::before {
      content: '';
      position: absolute;
      top: 0;
      left: calc(var(--u) * -30);
      width: 1px;
      height: calc(var(--u) * 53);
      background: var(--color-gold-light);
    }
  }
</style>
