---
/**
 * Ítem de acordeón sin JavaScript (elemento nativo <details>/<summary>).
 * Reutilizable para el listado de FAQs y, en mobile, para el listado de servicios.
 */
interface Props {
  question: string;
  open?: boolean;
}

const { question, open = false } = Astro.props;
---

<details class="accordion-item" open={open}>
  <summary class="accordion-item__summary">
    <span class="accordion-item__question">{question}</span>
    <span class="accordion-item__chevron" aria-hidden="true"></span>
  </summary>
  <div class="accordion-item__content">
    <slot />
  </div>
</details>

<style>
  .accordion-item {
    border-bottom: 1px solid rgba(184, 147, 90, 0.3);
  }

  .accordion-item__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .accordion-item__summary::-webkit-details-marker {
    display: none;
  }

  .accordion-item__question {
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--color-cream);
  }

  .accordion-item__chevron {
    flex-shrink: 0;
    width: 0.6rem;
    height: 0.6rem;
    border-right: 2px solid var(--color-gold);
    border-bottom: 2px solid var(--color-gold);
    transform: rotate(45deg);
    transition: transform 0.15s ease;
  }

  .accordion-item[open] > .accordion-item__summary .accordion-item__chevron {
    transform: rotate(-135deg);
  }

  .accordion-item__content {
    padding-bottom: 1.25rem;
    color: var(--color-cream);
    opacity: 0.85;
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>
