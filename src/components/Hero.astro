---
/**
 * Hero (Section 53:60 en Figma). La foto (nodo 174:113) es un único PNG recortado
 * (mujer + skyline, fondo transparente) pensado para ir de fondo a lo ancho de TODA
 * la sección — incluida la fila de ValueBadges — no como imagen contenida en una
 * columna. En mobile se mantiene como imagen contenida (no hay bleed de fondo en el
 * frame mobile de Figma); a partir de 1024px pasa a ser el fondo absoluto de `.hero`.
 *
 * El lockup (ícono/TARGET/INVESTIGATIONS/tagline/subtítulo/botón) está centrado
 * internamente y no alineado a la izquierda (confirmado midiendo los bounding boxes
 * de los nodos reales: cada línea de texto está centrada dentro del frame "Logo").
 * "TARGET" y el tagline usan Cinzel; "INVESTIGATIONS" y el subtítulo usan Instrument
 * Sans — ninguna es la fuente Inter/Fraunces del resto del sitio (ver tokens.css).
 */
import { Image } from 'astro:assets';
import Container from './Container.astro';
import ValueBadges from './ValueBadges.astro';
import WhatsAppCta from './WhatsAppCta.astro';
import logoMark from '../icons/logo-mark.svg?raw';
import heroPhoto from '../images/hero.png';
import { siteConfig } from '../config/site';
---

<div class="hero">
  <Container size="wide">
    <div class="hero__lockup">
      <span class="hero__icon" aria-hidden="true" set:html={logoMark} />

      <p class="hero__brand">TARGET</p>
      <p class="hero__brand-sub">INVESTIGATIONS</p>

      <span class="hero__divider" aria-hidden="true"></span>

      <h1 class="hero__tagline">
        <span class="hero__tagline-line" aria-hidden="true"></span>
        {siteConfig.company.tagline}
        <span class="hero__tagline-line" aria-hidden="true"></span>
      </h1>

      <p class="hero__subtitle">
        <span>Private Investigations</span>
        <span class="hero__dot" aria-hidden="true"></span>
        <span>Intelligence</span>
        <span class="hero__dot" aria-hidden="true"></span>
        <span>Due Diligence</span>
      </p>

      <WhatsAppCta class="hero__cta" />
    </div>
  </Container>

  <div class="hero__photo" aria-hidden="true">
    <Image
      src={heroPhoto}
      alt=""
      widths={[440, 768, 1200, 1672]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__photo-fade"></div>
  </div>

  <Container size="wide">
    <ValueBadges />
  </Container>
</div>

<style>
  .hero {
    position: relative;
    /* El solape negativo de ValueBadges sobre la foto (margin-top:-21%) hace que la
       foto, un elemento anterior en el flujo normal, pinte más abajo de donde el
       propio flujo termina calculando la altura de `.hero` — sin recortar esto la
       foto se desborda visualmente sobre la sección de Services. */
    overflow: hidden;
    /* El header es fixed y se superpone (backdrop-blur) — antes este padding se
       sumaba al padding-block genérico del <section> (ver #hero en index.astro) para
       despejarlo; al quitar ese padding extra, el logo quedaba parcialmente tapado
       detrás del header. Ahora este valor por sí solo tiene que cubrir esa altura. */
    padding-top: clamp(5.5rem, 22vw, 6.5rem);
    /* Sin padding-bottom: en el nodo real la línea divisoria con Services empieza
       apenas termina la foto (incluso se solapa unos px con su borde inferior) — con
       padding acá quedaba un espacio de fondo navy plano antes de la línea dorada. */
    padding-bottom: 0;
    /* Fondo radial "de luz" (nodo real `Frame 41` que envuelve todo el Hero mobile):
       sin esto la foto se ve plana/azul en vez del tono cálido y con más vida del
       diseño — se transparenta a través de la foto (opacity:0.83) y del espacio
       alrededor del lockup. */
    background: radial-gradient(130% 100% at 40% 45%, #4c6684 0%, #0c2342 55%, #021224 100%);
  }

  /* --- Mobile: foto contenida, en flujo normal (no hay bleed de fondo en el frame mobile).
       El nodo real (`Backgound 2`, 341:1572) tiene opacity:0.83 (no 100%) y un
       degradado navy que oscurece del ~37% al ~98% de su alto (`Rectangle 8`,
       341:1662) — sin esto la foto se ve plana/azul en vez del tono cálido difuminado
       del diseño. Las ValueBadges además se solapan con la parte baja de la foto
       (empiezan ~21% antes de que la foto termine), no van separadas con un margen. --- */
  .hero__photo {
    position: relative;
  }

  .hero__photo :global(img) {
    width: 100%;
    height: auto;
    display: block;
    opacity: 0.83;
  }

  .hero__photo-fade {
    display: block;
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 35%, rgba(9, 30, 57, 0.92) 88%, rgba(9, 30, 57, 0.92) 100%);
  }

  .hero > :global(.container:last-of-type) {
    position: relative;
    z-index: 1;
    margin-top: -21%;
    /* Un poco de aire entre las etiquetas y la línea divisoria — quedaban demasiado
       pegadas al borde. */
    margin-bottom: 1.5rem;
  }

  .hero__lockup {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.85rem;
    margin-bottom: clamp(2rem, 6vw, 3rem);
  }

  .hero__icon {
    display: block;
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: 0.25rem;
  }

  .hero__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .hero__brand {
    font-family: var(--font-cinzel);
    font-weight: 800;
    font-size: 2.5rem;
    letter-spacing: 0.04em;
    line-height: 1;
    margin: 0;
    /* Gradiente dorado vertical muestreado del ícono (nodo 53:482) para el wordmark. */
    background: linear-gradient(180deg, var(--color-gold-light) 0%, #9b7739 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .hero__brand-sub {
    font-family: var(--font-instrument);
    font-weight: 400;
    font-size: 0.98rem;
    letter-spacing: 0.38em;
    color: var(--color-white);
    margin: 0;
    /* Compensa el letter-spacing final para mantener el centrado óptico del texto. */
    padding-left: 0.38em;
  }

  .hero__divider {
    width: 70%;
    max-width: 20rem;
    height: 1px;
    margin-block: 0.15rem;
    background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.68), transparent);
  }

  .hero__tagline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-family: var(--font-cinzel);
    font-weight: 600;
    color: var(--color-gold);
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0;
  }

  .hero__tagline-line {
    flex: 0 0 1.75rem;
    height: 1px;
    background: linear-gradient(to right, var(--color-gold), transparent);
  }

  .hero__tagline-line:last-child {
    background: linear-gradient(to left, var(--color-gold), transparent);
  }

  .hero__subtitle {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-instrument);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-white);
    margin: 0.25rem 0 0.5rem;
  }

  .hero__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background-color: #e8e8e8;
  }

  /* Tamaño del CTA en el Hero (nodo 399:561 en Figma). El comportamiento hover→WhatsApp
     vive en WhatsAppCta.astro; acá solo se ajusta el tamaño para este contexto.
     :global() porque el <a> real lo renderiza ese componente hijo, no este archivo
     (ver memoria "astro-scoped-css-child-component-gotcha"). */
  :global(.hero__cta) {
    min-width: 18rem;
  }

  /* --- Desktop: la altura de `.hero` la fija un `min-height` explícito (no el
       contenido), y la foto pasa a ser `position:absolute;inset:0` de esa caja
       completa — así la imagen SIEMPRE arranca en el borde superior de la sección
       y llega exactamente hasta el borde inferior, sin huecos en ninguno de los dos
       extremos. Lockup y ValueBadges se superponen encima (ambos absolutos, anclados
       arriba/abajo respectivamente) en vez de ocupar espacio en el flujo — así nunca
       "empujan" la altura de `.hero` por debajo de lo que la foto cubre. Con
       `object-fit:cover` + `object-position:left top` el recorte (cuando la relación
       de aspecto del contenedor lo exige) siempre sale por la derecha/abajo —el agua y
       el cielo, contenido no crítico— y nunca por arriba/izquierda, donde está la cabeza. --- */
  @media (min-width: 1024px) {
    .hero {
      /* En desktop no hace falta recortar: la foto es position:absolute;inset:0 y
         nunca se desborda, y la descripción de ValueBadges en hover sí necesita
         poder salir un poco de la caja sin que se corte. */
      overflow: visible;
      padding-block: 0;
      /* El piso subió de 38rem a 47rem: a anchos "tablet" (~1024-1300px) el bloque de
         texto+botón (anclado arriba) mide ~553px, y con el piso anterior la caja del
         Hero podía quedar más baja que eso, haciendo que la fila de íconos (anclada
         abajo) se solapara con el botón. Medido con Playwright en varios anchos. */
      min-height: clamp(47rem, 52vw, 50rem);
    }

    /* Contenedor del lockup: superpuesto, anclado arriba, ancho completo. */
    .hero > :global(.container:first-of-type) {
      position: absolute;
      inset-block-start: 0;
      inset-inline: 0;
      z-index: 2;
    }

    /* Contenedor de ValueBadges: superpuesto, anclado abajo, sobre la parte oscurecida de la foto.
       Subido de 2.5rem a 6rem: la descripción más larga (4 renglones, ej. "Precision")
       todavía quedaba con el último renglón debajo de la línea divisoria con 4.5rem. */
    .hero > :global(.container:last-of-type) {
      position: absolute;
      inset-block-end: 6rem;
      inset-inline: 0;
      z-index: 1;
      margin-top: 0;
      margin-bottom: 0;
    }

    .hero__photo {
      position: absolute;
      inset: 0;
      z-index: 0;
      /* Fondo radial muestreado del propio Section (53:60): se transparenta a través
         de la foto (fill al 70% de opacidad en Figma) dándole el aspecto "difuminado"
         que tiene en el diseño, en vez de la foto a opacidad plena y bordes duros. */
      background: radial-gradient(120% 120% at 19% 32%, #35566f 0%, #12243c 47%, #000f26 100%);
    }

    .hero__photo :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: left top;
      opacity: 0.7;
    }

    .hero__photo-fade {
      display: block;
      position: absolute;
      inset: 0;
      /* Aproximación de los degradados de Figma (nodos 53:62/187:844): oscurece la
         parte inferior de la foto para que ValueBadges se lea con buen contraste. */
      background: linear-gradient(
        to top,
        rgba(3, 10, 24, 0.85) 0%,
        rgba(3, 10, 24, 0.4) 18%,
        transparent 38%
      );
    }

    .hero__lockup {
      max-width: 34rem;
      margin-left: auto;
      margin-right: clamp(0rem, 6vw, 4rem);
      padding-block: clamp(3rem, 9vw, 5.5rem) 2.5rem;
    }

    .hero__icon {
      width: 4.5rem;
      height: 4.5rem;
    }

    .hero__brand {
      font-size: 4.25rem;
    }

    .hero__brand-sub {
      font-size: 1.35rem;
    }

    .hero__tagline {
      font-size: 1.4rem;
    }
  }
</style>
