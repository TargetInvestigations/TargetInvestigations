---
/**
 * Hero (Section 53:60 en Figma, 1549×1000). Tres comportamientos:
 *
 * - Mobile (<1024px, frame 341:1569): lockup → botón → foto en flujo normal, con las
 *   ValueBadges solapando la parte baja de la foto.
 * - Desktop intermedio (1024–1439px, p. ej. 1366×768): layout propio, aprobado por el
 *   usuario para ese tamaño — caja de altura fija con foto `cover` y capas absolutas.
 * - Desktop estándar (≥1440px, p. ej. 1920×1080): réplica proporcional del frame de
 *   Figma. `.hero` es un contenedor (`container-type:inline-size`) y todo se posiciona
 *   y dimensiona en "unidades Figma" (`--u` = 1px del frame de 1549px, vía `cqi`), así
 *   que a cualquier ancho la composición es el diseño escalado. Como en Figma, la
 *   Section empieza en y=0 de la página y el nav de vidrio se superpone a ella.
 *
 * El lockup de marca (ícono/TARGET con destellos/INVESTIGATIONS/tagline/subtítulo) es
 * el PNG completo entregado por el cliente (desktop = frame "Logo" 175:759 sin el
 * botón; mobile = frame "Logo" 341:1573), no una recreación con texto — replicarlo
 * letra por letra no conseguía los detalles de brillo del diseño. El texto va en el
 * `alt`, dentro del <h1>.
 */
import { Image, getImage } from 'astro:assets';
import Container from './Container.astro';
import ValueBadges from './ValueBadges.astro';
import WhatsAppCta from './WhatsAppCta.astro';
import heroPhoto from '../images/hero.png';
import heroSky from '../images/hero-sky.png';
import logoDesktop from '../images/logo-lockup-desktop.png';
import logoMobile from '../images/logo-lockup-mobile.png';
import { siteConfig } from '../config/site';

const logoDesktopImg = await getImage({
  src: logoDesktop,
  widths: [448, 640, 896, 1280, 1874],
  format: 'webp',
});
const logoMobileImg = await getImage({
  src: logoMobile,
  widths: [366, 732, 1098],
  format: 'webp',
});
const logoAlt = `${siteConfig.company.name} — ${siteConfig.company.tagline}. Private Investigations · Intelligence · Due Diligence`;
---

<div class="hero">
  <!-- Textura de cielo (nodo 179:813, opacity 0.46) — solo en la réplica ≥1440px. -->
  <div class="hero__sky" aria-hidden="true">
    <Image src={heroSky} alt="" widths={[1146, 1672]} sizes="74vw" loading="lazy" />
  </div>

  <Container size="wide" class="hero__top">
    <div class="hero__lockup">
      <h1 class="hero__logo">
        <picture>
          <source
            media="(min-width: 1024px)"
            type="image/webp"
            srcset={logoDesktopImg.srcSet.attribute}
            sizes="(min-width: 1440px) 41vw, 28rem"
          />
          <source
            type="image/webp"
            srcset={logoMobileImg.srcSet.attribute}
            sizes="min(83.2vw, 23rem)"
          />
          <img
            src={logoMobileImg.src}
            alt={logoAlt}
            width={logoMobile.width}
            height={logoMobile.height}
            loading="eager"
            decoding="async"
          />
        </picture>
      </h1>

      <WhatsAppCta class="hero__cta" />
    </div>
  </Container>

  <div class="hero__photo" aria-hidden="true">
    <Image
      src={heroPhoto}
      alt=""
      widths={[440, 768, 1200, 1672, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__photo-fade"></div>
  </div>

  <Container size="wide" class="hero__bottom">
    <ValueBadges />
  </Container>
</div>

<style>
  .hero {
    position: relative;
    /* El solape negativo de ValueBadges sobre la foto (margin-top:-21%) hace que la
           foto, un elemento anterior en el flujo normal, pinte más abajo de donde el
           propio flujo termina calculando la altura de `.hero` — sin recortar esto la
           foto se desborda visualmente sobre la sección de Services. */
    overflow: hidden;
    /* 36px entre el header y el logo (frame "Logo" 341:1573 en y=36 del Hero mobile). */
    padding-top: 2.25rem;
    /* Sin padding-bottom: en el nodo real la línea divisoria con Services empieza
           apenas termina la foto. */
    padding-bottom: 0;
    /* Alto de la caja de la foto mobile: 381px sobre 440 de ancho (86.6%), con tope
         para anchos de tablet que todavía usan este layout. */
    --photo-h: min(86.65vw, 32.5rem);
    /* Fondo radial de `Frame 41` (341:1660): #4C6684 → #0C2342 (61%) → #021124, centro
         en 40%/53%. */
    background: radial-gradient(120% 68% at 40% 53%, #4c6684 0%, #0c2342 61%, #021124 100%);
  }

  .hero__sky {
    display: none;
  }

  /* --- Mobile: foto contenida, en flujo normal. Nodo `Backgound 2` (341:1572) con
       opacity 0.83 + degradado navy `Rectangle 8` (341:1662). --- */
  /* La caja mide 440×381 pero la imagen (1672×941) se dibuja al 146% del ancho,
     anclada arriba a la izquierda (imageTransform: se ve el 68.4% izquierdo), así que la
     persona y el skyline se ven grandes — antes mostrábamos la imagen completa a
     440×247. Con `max(…, 100%)` la imagen siempre cubre el ancho en tablets. */
  .hero__photo {
    position: relative;
    height: var(--photo-h);
    overflow: hidden;
  }

  .hero__photo :global(img) {
    display: block;
    width: max(calc(var(--photo-h) * 1.686), 100%);
    max-width: none;
    height: auto;
    opacity: 0.83;
  }

  /* `Rectangle 8` (341:1662): empieza al 37.5% de la caja de la foto y mide el 60.2%;
     navy #091E39 opaco en su 17% inferior y transparente arriba. */
  .hero__photo-fade {
    display: block;
    position: absolute;
    inset: 37.5% 0 auto;
    height: 60.2%;
    background: linear-gradient(to top, #091e39 0%, #091e39 17%, rgba(9, 30, 57, 0) 100%);
  }

  /* Íconos (Group 41, 399:523): empiezan 93px antes del borde inferior de la foto y el
     Hero termina 19px debajo de las etiquetas (relativo a la altura de la foto). */
  .hero > :global(.hero__bottom) {
    position: relative;
    z-index: 1;
    margin-top: calc(var(--photo-h) * -0.244);
    margin-bottom: calc(var(--photo-h) * 0.05);
  }

  /* Mobile: logo 366px de ancho sobre 440 (83.2%), botón 10px debajo, foto 10px
     debajo del botón (nodos 341:1573 / 399:599 / 341:1572). */
  .hero__lockup {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.625rem;
    margin-bottom: 0.625rem;
  }

  .hero__logo {
    width: min(83.2vw, 23rem);
    margin: 0;
  }

  .hero__logo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1649 / 1032;
  }

  /* Tamaño del CTA en el Hero (nodo 399:561 en Figma). El comportamiento hover→WhatsApp
     vive en WhatsAppCta.astro; acá solo se ajusta el tamaño para este contexto.
     :global() porque el <a> real lo renderiza ese componente hijo, no este archivo. */
  :global(.hero__cta) {
    min-width: 18rem;
  }

  /* Mobile: botón 312×51, texto 15.9px (instancia 399:599). */
  @media (max-width: 1023px) {
    /* `.hero` delante: sin él pierde contra el padding base de WhatsAppCta. */
    .hero :global(.hero__cta) {
      min-width: min(70.9vw, 19.5rem);
      height: 3.1875rem;
      /* La Inter web es algo más ancha: con 1rem por lado queda en los 312px de Figma. */
      padding: 0 1rem;
    }

    .hero :global(.hero__cta .whatsapp-cta__face) {
      font-size: 1rem;
    }
  }

  /* --- Desktop intermedio (1024–1439px): la altura de `.hero` la fija un `min-height`
       explícito y foto, lockup y ValueBadges son capas absolutas. `object-fit:cover`
       con `object-position:left top` recorta siempre por derecha/abajo (agua y cielo),
       nunca la cabeza. --- */
  @media (min-width: 1024px) {
    .hero {
      /* La descripción de ValueBadges en hover necesita poder salir un poco de la caja. */
      overflow: visible;
      padding-block: 0;
      /* Piso de 47rem: a anchos ~1024-1300px el bloque logo+botón (anclado arriba) no
                 debe solaparse con la fila de íconos (anclada abajo). */
      min-height: clamp(47rem, 52vw, 50rem);
    }

    .hero > :global(.hero__top) {
      position: absolute;
      inset-block-start: 0;
      inset-inline: 0;
      z-index: 2;
    }

    .hero > :global(.hero__bottom) {
      position: absolute;
      inset-block-end: 6rem;
      inset-inline: 0;
      z-index: 1;
      margin-top: 0;
      margin-bottom: 0;
    }

    .hero__photo {
      position: absolute;
      inset: 0;
      z-index: 0;
      /* Reset de la caja mobile. */
      height: auto;
      overflow: visible;
      background: radial-gradient(120% 120% at 19% 32%, #35566f 0%, #12243c 47%, #000f26 100%);
    }

    .hero__photo :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: left top;
      opacity: 0.7;
    }

    .hero__photo-fade {
      /* Reset de la posición mobile (Rectangle 8). */
      inset: 0;
      height: auto;
      background: linear-gradient(
        to top,
        rgba(3, 10, 24, 0.85) 0%,
        rgba(3, 10, 24, 0.4) 18%,
        transparent 38%
      );
    }

    .hero__lockup {
      max-width: 34rem;
      margin-left: auto;
      margin-right: clamp(0rem, 6vw, 4rem);
      padding-block: clamp(3rem, 9vw, 5.5rem) 2.5rem;
      gap: 1rem;
    }

    .hero__logo {
      width: 28rem;
    }

    .hero__logo img {
      aspect-ratio: 1874 / 1493;
    }
  }

  /* --- Desktop estándar (≥1440px): réplica proporcional del frame 53:60. Cada valor
       `calc(var(--u) * N)` es N px del frame de Figma de 1549px de ancho. --- */
  @media (min-width: 1440px) {
    .hero {
      --u: calc(100cqi / 1549);
      container-type: inline-size;
      aspect-ratio: 1549 / 1000;
      min-height: 0;
      /* En Figma la Section arranca en y=0 y el nav (68px, vidrio) se superpone. */
      margin-top: -68px;
      /* Fill real de la Section 53:60 (GRADIENT_RADIAL, centro 19%/32%). */
      background: radial-gradient(78.6% 108% at 19% 32%, #354b62 0%, #12243c 47%, #000f26 100%);
    }

    /* Capa recortada al Hero (clipsContent de la Section) — la textura sobresale
           43px por arriba y 9px por la izquierda en Figma. */
    .hero__sky {
      display: block;
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    /* Relleno real de 179:813: blend LINEAR_DODGE (suma de luz = `plus-lighter`),
           filtros exposure -0.1 / contrast +0.16 / saturation -0.67, e imageTransform que
           recorta el 2.9% izquierdo de la imagen (por eso el <img> es más ancho que la
           caja de 1146px y arranca antes). */
    .hero__sky :global(img) {
      position: absolute;
      left: calc(var(--u) * -43.2);
      top: calc(var(--u) * -43);
      width: calc(var(--u) * 1180.2);
      height: calc(var(--u) * 664);
      max-width: none;
      opacity: 0.46;
      mix-blend-mode: plus-lighter;
      filter: brightness(0.93) contrast(1.16) saturate(0.33);
    }

    /* Foto (174:113): x=0 y=129, 1549×872, opacity 0.7 — misma proporción que la
           imagen, así que no se recorta. */
    .hero__photo {
      inset: calc(var(--u) * 129) 0 0 0;
      background: none;
    }

    .hero__photo :global(img) {
      object-fit: cover;
      object-position: center bottom;
      opacity: 0.7;
    }

    /* Capas sobre la foto: degradados `Rectangle 7` (53:62, y=680 h=321) y `Rectangle 8`
           (187:844, y=801 h=199) y brillo dorado radial al 6% (53:64). Alturas y posiciones
           relativas a la caja de la foto. (El tinte de 53:63 tiene sus dos paradas en la
           posición 0 → no se ve en Figma, así que no se replica.) */
    .hero__photo-fade {
      background:
        linear-gradient(to top, #03132b, rgba(9, 30, 57, 0)) bottom / 100% 36.8% no-repeat,
        linear-gradient(to top, #041125, rgba(9, 30, 57, 0)) bottom / 100% 22.8% no-repeat,
        radial-gradient(
          calc(var(--u) * 426) at 39.4% 49.8%,
          rgba(184, 147, 90, 0.06) 0%,
          rgba(184, 147, 90, 0) 70%
        );
    }

    /* Alto 0 (anclado arriba): el lockup se posiciona dentro con coordenadas del
           frame. Con `inset:0` esta capa (z-index 2) tapaba la fila de íconos y bloqueaba
           su hover. */
    .hero > :global(.hero__top) {
      inset: 0 0 auto 0;
      max-width: none;
      padding: 0;
    }

    /* Frame "Logo" 175:759: x=717, y=151, 625px de ancho; el PNG ocupa hasta y=649 y
           el botón (399:561) empieza en y=662. */
    .hero__lockup {
      position: absolute;
      left: calc(var(--u) * 717);
      top: calc(var(--u) * 151);
      width: calc(var(--u) * 625);
      max-width: none;
      margin: 0;
      padding: 0;
      gap: calc(var(--u) * 13);
    }

    .hero__logo {
      width: 100%;
    }

    /* Botón 358×59, texto Inter Bold 18.3px. */
    :global(.hero__cta) {
      min-width: calc(var(--u) * 358);
      height: calc(var(--u) * 59);
      padding: 0 calc(var(--u) * 24);
    }

    :global(.hero__cta .whatsapp-cta__face) {
      font-size: calc(var(--u) * 18.3);
    }

    :global(.hero__cta .whatsapp-cta__icon) {
      width: calc(var(--u) * 26);
      height: calc(var(--u) * 26);
    }

    /* Fila de ValueBadges (Group 38): círculos en y=834. El tamaño interno de la fila
           vive en ValueBadges.astro (mismas unidades). */
    .hero > :global(.hero__bottom) {
      inset: calc(var(--u) * 830) 0 auto 0;
      max-width: none;
      padding: 0;
    }
  }
</style>
