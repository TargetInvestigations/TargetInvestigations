---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import Button from './Button.astro';
import ValueBadges from './ValueBadges.astro';
import logoMark from '../icons/logo-mark.svg?raw';
import heroPhoto from '../images/hero.png';
import { siteConfig } from '../config/site';
---

<div class="hero">
  <Container size="wide">
    <div class="hero__grid">
      <div class="hero__content">
        <span class="hero__icon" aria-hidden="true" set:html={logoMark} />
        <p class="hero__brand">
          TARGET
          <br />
          INVESTIGATIONS
        </p>
        <h1 class="hero__tagline">{siteConfig.company.tagline}</h1>
        <p class="hero__subtitle">Private Investigations · Intelligence · Due Diligence</p>
        <Button href="#contact" variant="solid">
          Request a Confidential Consultation
        </Button>
      </div>

      <div class="hero__photo">
        <Image
          src={heroPhoto}
          alt="Private investigator overlooking a South Florida city skyline"
          widths={[440, 768, 1000]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </Container>

  <Container size="wide">
    <ValueBadges />
  </Container>
</div>

<style>
  .hero {
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    margin-bottom: clamp(2rem, 6vw, 4rem);
  }

  .hero__photo :global(img) {
    width: 100%;
    height: auto;
    /* La foto es un recorte PNG con fondo transparente (persona + skyline), no un
         rectángulo con marco — sin border-radius/sombra para que se funda con el fondo. */
    display: block;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
  }

  .hero__icon {
    display: block;
    width: 3rem;
    height: 3rem;
  }

  .hero__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .hero__brand {
    font-family: var(--font-display);
    font-size: 1.75rem;
    letter-spacing: 0.08em;
    color: var(--color-cream);
    line-height: 1.2;
    margin: 0;
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-gold-light);
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hero__subtitle {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-cream);
    opacity: 0.75;
    margin-bottom: 0.5rem;
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }

    /* En desktop la foto va a la izquierda y el lockup a la derecha (Figma); en mobile
         el orden natural del DOM ya pone el lockup arriba y la foto debajo. */
    .hero__photo {
      order: -1;
    }

    .hero__content {
      align-items: flex-start;
      text-align: left;
    }

    .hero__brand {
      font-size: 2.5rem;
    }

    .hero__tagline {
      font-size: 1.4rem;
    }
  }
</style>
