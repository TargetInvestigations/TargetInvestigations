---
/**
 * Hero (Section 53:60 en Figma). La foto (nodo 174:113) es un único PNG recortado
 * (mujer + skyline, fondo transparente) pensado para ir de fondo a lo ancho de TODA
 * la sección — incluida la fila de ValueBadges — no como imagen contenida en una
 * columna. En mobile se mantiene como imagen contenida (no hay bleed de fondo en el
 * frame mobile de Figma); a partir de 1024px pasa a ser el fondo absoluto de `.hero`.
 *
 * El lockup (ícono/TARGET/INVESTIGATIONS/tagline/subtítulo/botón) está centrado
 * internamente y no alineado a la izquierda (confirmado midiendo los bounding boxes
 * de los nodos reales: cada línea de texto está centrada dentro del frame "Logo").
 * "TARGET" y el tagline usan Cinzel; "INVESTIGATIONS" y el subtítulo usan Instrument
 * Sans — ninguna es la fuente Inter/Fraunces del resto del sitio (ver tokens.css).
 */
import { Image } from 'astro:assets';
import Container from './Container.astro';
import ValueBadges from './ValueBadges.astro';
import logoMark from '../icons/logo-mark.svg?raw';
import whatsappIcon from '../icons/whatsapp.svg?raw';
import heroPhoto from '../images/hero.png';
import { siteConfig, getWhatsAppLink } from '../config/site';

const whatsappHref = getWhatsAppLink() ?? '#contact';
// Mismo placeholder que usa el propio Figma para este botón ("+1 123 4567890"), pendiente del cliente.
const phoneDisplay = siteConfig.contact.phoneDisplay ?? '+1 123 4567890';
---

<div class="hero">
  <Container size="wide">
    <div class="hero__lockup">
      <span class="hero__icon" aria-hidden="true" set:html={logoMark} />

      <p class="hero__brand">TARGET</p>
      <p class="hero__brand-sub">INVESTIGATIONS</p>

      <span class="hero__divider" aria-hidden="true"></span>

      <h1 class="hero__tagline">
        <span class="hero__tagline-line" aria-hidden="true"></span>
        {siteConfig.company.tagline}
        <span class="hero__tagline-line" aria-hidden="true"></span>
      </h1>

      <p class="hero__subtitle">
        <span>Private Investigations</span>
        <span class="hero__dot" aria-hidden="true"></span>
        <span>Intelligence</span>
        <span class="hero__dot" aria-hidden="true"></span>
        <span>Due Diligence</span>
      </p>

      <a
        href={whatsappHref}
        class="hero__cta"
        aria-label={`Request a confidential consultation — WhatsApp ${phoneDisplay}`}
      >
        <span class="hero__cta-face hero__cta-face--default" aria-hidden="true">
          Request a Confidential Consultation
        </span>
        <span class="hero__cta-face hero__cta-face--whatsapp" aria-hidden="true">
          <span class="hero__cta-icon" set:html={whatsappIcon} />
          {phoneDisplay}
        </span>
      </a>
    </div>
  </Container>

  <div class="hero__photo" aria-hidden="true">
    <Image
      src={heroPhoto}
      alt=""
      widths={[440, 768, 1200, 1672]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__photo-fade"></div>
  </div>

  <Container size="wide">
    <ValueBadges />
  </Container>
</div>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  /* --- Mobile: foto contenida, en flujo normal (no hay bleed de fondo en el frame mobile) --- */
  .hero__photo {
    position: relative;
    margin-bottom: clamp(2rem, 6vw, 3rem);
  }

  .hero__photo :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero__photo-fade {
    display: none;
  }

  .hero__lockup {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.85rem;
    margin-bottom: clamp(2rem, 6vw, 3rem);
  }

  .hero__icon {
    display: block;
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: 0.25rem;
  }

  .hero__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .hero__brand {
    font-family: var(--font-cinzel);
    font-weight: 800;
    font-size: 2.5rem;
    letter-spacing: 0.04em;
    line-height: 1;
    margin: 0;
    /* Gradiente dorado vertical muestreado del ícono (nodo 53:482) para el wordmark. */
    background: linear-gradient(180deg, var(--color-gold-light) 0%, #9b7739 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .hero__brand-sub {
    font-family: var(--font-instrument);
    font-weight: 400;
    font-size: 0.9rem;
    letter-spacing: 0.35em;
    color: var(--color-white);
    margin: 0;
    /* Compensa el letter-spacing final para mantener el centrado óptico del texto. */
    padding-left: 0.35em;
  }

  .hero__divider {
    width: 70%;
    max-width: 20rem;
    height: 1px;
    margin-block: 0.15rem;
    background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.68), transparent);
  }

  .hero__tagline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-family: var(--font-cinzel);
    font-weight: 600;
    color: var(--color-gold);
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0;
  }

  .hero__tagline-line {
    flex: 0 0 1.75rem;
    height: 1px;
    background: linear-gradient(to right, var(--color-gold), transparent);
  }

  .hero__tagline-line:last-child {
    background: linear-gradient(to left, var(--color-gold), transparent);
  }

  .hero__subtitle {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-instrument);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-white);
    margin: 0.25rem 0 0.5rem;
  }

  .hero__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background-color: #e8e8e8;
  }

  /* --- Botón CTA con "swap" a WhatsApp en hover/focus (nodos 399:561 / 53:41 en Figma) --- */
  .hero__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18rem;
    padding: 0.9rem 1.75rem;
    border-radius: var(--radius-button);
    background: var(--gradient-button);
    text-decoration: none;
    overflow: hidden;
    transition: background 0.4s ease;
  }

  .hero__cta-face {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-button);
    white-space: nowrap;
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .hero__cta-face--default {
    color: var(--color-bg-alt);
  }

  .hero__cta-face--whatsapp {
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    color: var(--color-gold-light);
    opacity: 0;
    transform: translateX(20%);
  }

  .hero__cta-icon {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
  }

  .hero__cta-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    background: var(--color-gold-dark);
  }

  .hero__cta:hover .hero__cta-face--default,
  .hero__cta:focus-visible .hero__cta-face--default {
    opacity: 0;
    transform: translateX(-20%);
  }

  .hero__cta:hover .hero__cta-face--whatsapp,
  .hero__cta:focus-visible .hero__cta-face--whatsapp {
    opacity: 1;
    transform: translateX(0);
  }

  .hero__cta:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 2px;
  }

  /* --- Desktop: la altura de `.hero` la fija un `min-height` explícito (no el
       contenido), y la foto pasa a ser `position:absolute;inset:0` de esa caja
       completa — así la imagen SIEMPRE arranca en el borde superior de la sección
       y llega exactamente hasta el borde inferior, sin huecos en ninguno de los dos
       extremos. Lockup y ValueBadges se superponen encima (ambos absolutos, anclados
       arriba/abajo respectivamente) en vez de ocupar espacio en el flujo — así nunca
       "empujan" la altura de `.hero` por debajo de lo que la foto cubre. Con
       `object-fit:cover` + `object-position:left top` el recorte (cuando la relación
       de aspecto del contenedor lo exige) siempre sale por la derecha/abajo —el agua y
       el cielo, contenido no crítico— y nunca por arriba/izquierda, donde está la cabeza. --- */
  @media (min-width: 1024px) {
    .hero {
      padding-block: 0;
      min-height: clamp(38rem, 52vw, 48rem);
    }

    /* Contenedor del lockup: superpuesto, anclado arriba, ancho completo. */
    .hero > :global(.container:first-of-type) {
      position: absolute;
      inset-block-start: 0;
      inset-inline: 0;
      z-index: 2;
    }

    /* Contenedor de ValueBadges: superpuesto, anclado abajo, sobre la parte oscurecida de la foto. */
    .hero > :global(.container:last-of-type) {
      position: absolute;
      inset-block-end: 2.5rem;
      inset-inline: 0;
      z-index: 1;
    }

    .hero__photo {
      position: absolute;
      inset: 0;
      margin-bottom: 0;
      z-index: 0;
      /* Fondo radial muestreado del propio Section (53:60): se transparenta a través
         de la foto (fill al 70% de opacidad en Figma) dándole el aspecto "difuminado"
         que tiene en el diseño, en vez de la foto a opacidad plena y bordes duros. */
      background: radial-gradient(120% 120% at 19% 32%, #35566f 0%, #12243c 47%, #000f26 100%);
    }

    .hero__photo :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: left top;
      opacity: 0.7;
    }

    .hero__photo-fade {
      display: block;
      position: absolute;
      inset: 0;
      /* Aproximación de los degradados de Figma (nodos 53:62/187:844): oscurece la
         parte inferior de la foto para que ValueBadges se lea con buen contraste. */
      background: linear-gradient(
        to top,
        rgba(3, 10, 24, 0.85) 0%,
        rgba(3, 10, 24, 0.4) 18%,
        transparent 38%
      );
    }

    .hero__lockup {
      max-width: 34rem;
      margin-left: auto;
      margin-right: clamp(0rem, 6vw, 4rem);
      padding-block: clamp(3rem, 9vw, 5.5rem) 2.5rem;
    }

    .hero__icon {
      width: 4.5rem;
      height: 4.5rem;
    }

    .hero__brand {
      font-size: 4.25rem;
    }

    .hero__brand-sub {
      font-size: 1.35rem;
    }

    .hero__tagline {
      font-size: 1.4rem;
    }
  }
</style>
