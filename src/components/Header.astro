---
import Container from './Container.astro';
import Button from './Button.astro';
import logoMark from '../icons/logo-mark.svg?raw';
import { siteConfig } from '../config/site';
---

<header class="header">
  <!-- Barra "We speak spanish!" (Rectangle 21/30 + texto 270:303 en Figma, pedido #1 del
       frame "Cambios / Correcciones" 547:582): encima del nav, con el texto cruzando
       lentamente de izquierda a derecha. Texto tal cual el nodo de Figma. -->
  <div class="header__announce">
    <p class="header__announce-track">
      <span class="header__announce-text">We speak spanish!</span>
    </p>
  </div>

  <Container size="wide">
    <div class="header__bar">
      <a href="#top" class="header__logo" aria-label={`${siteConfig.company.name} — Home`}>
        <span aria-hidden="true" set:html={logoMark} />
      </a>

      <details class="header__nav-toggle">
        <summary class="header__nav-toggle-btn" aria-label="Open menu">
          <span class="header__nav-toggle-icon" aria-hidden="true"></span>
        </summary>

        <nav class="header__nav" aria-label="Main">
          <ul class="header__nav-list">
            {siteConfig.nav.map((item) => (
              <li>
                <a href={item.href} class="header__nav-link">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
          <Button href="#contact" variant="ghost">
            Confidential Consultation
          </Button>
        </nav>
      </details>
    </div>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Fondo navy translúcido + desenfoque (nodo 53:481 en Figma): sin borde inferior. */
    background-color: rgba(11, 33, 63, 0.86);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* 40px de alto, fondo #E9C37E (Rectangle 30, la capa visible encima de Rectangle 21),
     texto Inter SemiBold 18.77px en #03122A (nodo 270:303). */
  .header__announce {
    height: 2.5rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--color-gold-light);
  }

  /* El track mide el ancho de la barra y se desplaza de 0 a +100%; el texto va corrido
     -100% de su propio ancho, así que entra desde fuera por la izquierda y sale por
     completo por la derecha antes de volver a empezar. Solo se anima `transform`. */
  .header__announce-track {
    width: 100%;
    margin: 0;
    white-space: nowrap;
    animation: header-announce 7s linear infinite;
  }

  .header__announce-text {
    display: inline-block;
    transform: translateX(-100%);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.1733rem;
    line-height: 1;
    color: #03122a;
  }

  @keyframes header-announce {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(100%);
    }
  }

  /* Sin movimiento: el texto queda fijo y centrado (el reset global solo acortaría la
     animación, dejando el texto fuera de la barra). */
  @media (prefers-reduced-motion: reduce) {
    .header__announce-track {
      animation: none;
      text-align: center;
    }

    .header__announce-text {
      transform: none;
    }
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
  }

  .header__logo {
    display: block;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
  }

  .header__logo span {
    display: block;
    width: 100%;
    height: 100%;
  }

  .header__logo :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* --- Toggle de menú mobile, sin JavaScript (elemento <details>) --- */
  .header__nav-toggle-btn {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
  }

  .header__nav-toggle-btn::-webkit-details-marker {
    display: none;
  }

  /* Ícono de 2 líneas (Component 22, 341:1615 en Figma): 21.6×2.4px cada una, #E9C37E,
     separadas ~8.4px de borde superior a borde superior. La variante "Variant2" del
     mismo componente es una X (líneas rotadas ±45°) — se usa para el estado abierto. */
  .header__nav-toggle-icon {
    position: relative;
    display: block;
    width: 1.35rem;
    height: 0.675rem;
  }

  .header__nav-toggle-icon::before,
  .header__nav-toggle-icon::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 0.15rem;
    background-color: var(--color-gold-light);
    transition: transform 0.3s ease-out;
  }

  .header__nav-toggle-icon::before {
    top: 0;
  }

  .header__nav-toggle-icon::after {
    bottom: 0;
  }

  .header__nav-toggle[open] .header__nav-toggle-icon::before {
    transform: translateY(0.2625rem) rotate(45deg);
  }

  .header__nav-toggle[open] .header__nav-toggle-icon::after {
    transform: translateY(-0.2625rem) rotate(-45deg);
  }

  .header__nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-gold);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .header__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .header__nav-link {
    position: relative;
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-nav);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    /* Figma usa blanco al 75% de opacidad (no blanco puro) para el texto del nav. */
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    padding-bottom: 0.1rem;
  }

  /* Barra inferior dorada (nodo 53:14, "Line 18"): en reposo es un elemento de
     ancho ~0 del mismo color; en hover crece de izquierda a derecha vía Smart Animate. */
  .header__nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-gold-light);
    transition: width 0.3s ease-out;
  }

  .header__nav-link:hover,
  .header__nav-link:focus-visible {
    color: var(--color-white);
  }

  .header__nav-link:hover::after,
  .header__nav-link:focus-visible::after {
    width: 100%;
  }

  /* --- Desktop: nav siempre visible en línea, se descarta el comportamiento de <details> ---
     Nota: Chromium moderno oculta el contenido cerrado de <details> vía content-visibility
     en el pseudo-elemento ::details-content, no solo con display:none. Forzar display en el
     hijo no alcanza; hay que anular ::details-content directamente. */
  @media (min-width: 1024px) {
    /* Misma velocidad aproximada (~85px/s) que en mobile, sobre un recorrido más largo. */
    .header__announce-track {
      animation-duration: 20s;
    }

    .header__nav-toggle-btn {
      display: none;
    }

    .header__nav-toggle::details-content {
      content-visibility: visible;
      block-size: auto;
      overflow: visible;
    }

    .header__nav {
      position: static;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 2.5rem;
      background-color: transparent;
      border-bottom: none;
      padding: 0;
      width: auto;
    }

    .header__nav-list {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }
  }
</style>
