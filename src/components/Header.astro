---
import Container from './Container.astro';
import Button from './Button.astro';
import logoMark from '../icons/logo-mark.svg?raw';
import { siteConfig } from '../config/site';
---

<header class="header">
  <Container size="wide">
    <div class="header__bar">
      <a href="#top" class="header__logo" aria-label={`${siteConfig.company.name} — Home`}>
        <span aria-hidden="true" set:html={logoMark} />
      </a>

      <details class="header__nav-toggle">
        <summary class="header__nav-toggle-btn" aria-label="Open menu">
          <span class="header__nav-toggle-icon" aria-hidden="true"></span>
        </summary>

        <nav class="header__nav" aria-label="Main">
          <ul class="header__nav-list">
            {siteConfig.nav.map((item) => (
              <li>
                <a href={item.href} class="header__nav-link">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
          <Button href="#contact" variant="solid">
            Confidential Consultation
          </Button>
        </nav>
      </details>
    </div>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-gold);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
  }

  .header__logo {
    display: block;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
  }

  .header__logo span {
    display: block;
    width: 100%;
    height: 100%;
  }

  .header__logo :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* --- Toggle de menú mobile, sin JavaScript (elemento <details>) --- */
  .header__nav-toggle-btn {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
  }

  .header__nav-toggle-btn::-webkit-details-marker {
    display: none;
  }

  .header__nav-toggle-icon,
  .header__nav-toggle-icon::before,
  .header__nav-toggle-icon::after {
    display: block;
    width: 1.5rem;
    height: 2px;
    background-color: var(--color-cream);
  }

  .header__nav-toggle-icon::before,
  .header__nav-toggle-icon::after {
    content: '';
    position: relative;
  }

  .header__nav-toggle-icon::before {
    top: 6px;
  }

  .header__nav-toggle-icon::after {
    top: 2px;
  }

  .header__nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-gold);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .header__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .header__nav-link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-nav);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-white);
    text-decoration: none;
  }

  .header__nav-link:hover,
  .header__nav-link:focus-visible {
    color: var(--color-gold);
  }

  /* --- Desktop: nav siempre visible en línea, se descarta el comportamiento de <details> ---
     Nota: Chromium moderno oculta el contenido cerrado de <details> vía content-visibility
     en el pseudo-elemento ::details-content, no solo con display:none. Forzar display en el
     hijo no alcanza; hay que anular ::details-content directamente. */
  @media (min-width: 1024px) {
    .header__nav-toggle-btn {
      display: none;
    }

    .header__nav-toggle::details-content {
      content-visibility: visible;
      block-size: auto;
      overflow: visible;
    }

    .header__nav {
      position: static;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 2.5rem;
      border-bottom: none;
      padding: 0;
      width: auto;
    }

    .header__nav-list {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }
  }
</style>
