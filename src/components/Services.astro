---

<div class="services">
  <div class="services__intro">
    <p class="services__kicker">Investigative Services</p>
    <h2 class="services__heading">What situation are you facing?</h2>
  </div>

  <div class="services__mobile-images" aria-hidden="true">
    <Image src={mobileTopA} alt="" widths={[215, 430, 645]} sizes="50vw" loading="lazy" />
    <Image src={mobileTopB} alt="" widths={[215, 430, 645]} sizes="50vw" loading="lazy" />
  </div>

  <div class="services__list">
    {services.map((service, i) => (
      <ServiceItem {...service} number={i + 1} images={images[i]} reverse={i % 2 === 1} />
    ))}
  </div>
</div>

<style>
  /* Mobile (frame 450:1571): kicker a 40px del borde, 40px de aire al final; filas
     con 24px de margen lateral y fotos del encabezado casi a sangre (5px). */
  .services {
    --u: 1px;
    container-type: inline-size;
    padding: 2.5rem 1.5rem;
  }

  .services__intro {
    text-align: center;
  }

  /* Kicker (450:1574): Inter 10px, tracking 1.2px, dorado. */
  .services__kicker {
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
    font-size: 0.625rem;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  /* Heading (450:1577): Fraunces SemiBold 26.5px/30.4px. */
  .services__heading {
    font-weight: 600;
    font-size: 1.65625rem;
    line-height: 1.147;
    letter-spacing: -0.02em;
    color: var(--color-white);
  }

  /* HeroImages (450:1579): 2 fotos de 215×180 sin separación, a 5px de los bordes. */
  .services__mobile-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 1.75rem calc(5px - 1.5rem) 1.25rem;
  }

  .services__mobile-images :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 215 / 180;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    /* 1px del frame de Figma; escala solo por encima de 1549px de ancho. */
    .services {
      --u: max(1px, 100cqi / 1549);
      /* Sin padding lateral: `cqi` se mide sobre el content-box, y con padding la
             escala quedaba por debajo de la de Figma. El margen lateral lo ponen los hijos. */
      padding: calc(var(--u) * 60) 0 calc(var(--u) * 15);
    }

    .services__mobile-images {
      display: none;
    }

    /* Encabezado (53:140): contenedor de 1167px; kicker Inter Bold 19px/33px con
         tracking 4.4px; heading Fraunces SemiBold 49px/56.4px en una caja de ~342px
         (por eso ocupa dos líneas), 20.4px debajo del kicker. */
    .services__intro {
      width: min(calc(var(--u) * 1167), 100% - 3rem);
      margin-inline: auto;
      text-align: left;
    }

    .services__kicker {
      margin: 0;
      font-weight: 700;
      font-size: calc(var(--u) * 19);
      line-height: calc(var(--u) * 33);
      letter-spacing: 0.23em;
    }

    .services__heading {
      /* 342px en Figma; la Fraunces web mide ~2% más ancho y "are you facing?"
             saltaba a una tercera línea — 352px mantiene los 2 renglones del diseño. */
      max-width: calc(var(--u) * 352);
      padding-top: calc(var(--u) * 20.4);
      font-size: calc(var(--u) * 49);
      line-height: calc(var(--u) * 56.4);
    }

    /* Lista (Frame 108): 1060px de ancho, 34px debajo del heading, 32px entre filas. */
    .services__list {
      width: min(calc(var(--u) * 1060), 100% - 3rem);
      margin: calc(var(--u) * 34) auto 0;
      display: flex;
      flex-direction: column;
      gap: calc(var(--u) * 32);
    }
  }
</style>
