// Mismo orden que `services`: impares una foto ancha, pares dos fotos verticales.
const images = [
  [img01],
  [img02a, img02b],
  [img03],
  [img04a, img04b],
  [img05],
  [img06a, img06b],
  [img07],
  [img08a, img08b],
  [img09],
];

