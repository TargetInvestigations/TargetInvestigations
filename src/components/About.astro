---
/**
 * About (instancia 322:1221 del componente 322:865 en Figma). Variantes del componente:
 * "Variant3" = colapsado (la que usa la página) y "Variant2" = expandido; el click en
 * "Show more" (ON_CLICK → CHANGE_TO 322:1096) cambia entre ambas.
 *
 * Desktop (≥1024px): contenedor de 1200px en 2 columnas de 560px (80px de separación).
 * Izquierda: kicker, heading (caja de 388px → 3 renglones) y bio (Meet Andrea Roa + 3
 * párrafos). Derecha: panel de stats 2×2 y la cita. Debajo, alineado al borde derecho
 * de la sección, el toggle "Show more"; al abrirlo aparecen el texto extendido (735px)
 * y la foto de Andrea (406×487, borde degradado dorado de 1px).
 *
 * Mobile (<1024px, frame 419:1424): el mismo contenido reducido a ~70% (factor
 * `--s: 0.697`, medido en Figma) — kicker y heading centrados, stats, bio. El frame
 * mobile no tiene cita, toggle ni foto: se ocultan la cita y la foto, pero el toggle se
 * conserva para no perder el texto extendido en mobile (decisión nuestra, ver CLAUDE.md).
 *
 * Unidades: `--u` = 1px del frame de Figma de 1549px (escala por encima de 1549px de
 * ancho, igual que Hero/Services); `.about` es el contenedor de `cqi`.
 */
import { Image } from 'astro:assets';
import StatBadges from './StatBadges.astro';
import aboutPhoto from '../images/about.png';
import { siteConfig } from '../config/site';

const { name, founder } = siteConfig.company;
---

<div class="about">
  <div class="about__grid">
    <div class="about__main">
      <p class="about__kicker">About</p>
      <h2 class="about__heading">Built on one simple principle: the truth doesn't negotiate.</h2>
      <div class="about__bio">
        <p class="about__lead">Meet {founder}</p>
        <p>
          For more than a decade, {founder} has been dedicated to the private investigative
          profession, building her experience around one fundamental principle: when the truth
          matters, the facts matter.
        </p>
        <p>
          As the founder and Principal Private Investigator of {name}, Andrea brings a professional,
          discreet, and detail-oriented approach to every assignment. Her commitment is to provide
          clients with reliable information, carefully documented evidence, and investigative
          support they can trust when important decisions are at stake.
        </p>
        <p>
          Andrea understands that every investigation is different. Some involve deeply personal
          family matters. Others involve businesses, attorneys, financial concerns, insurance
          claims, or complex civil disputes. Regardless of the circumstances, her approach remains
          the same: listen carefully, investigate responsibly, protect confidentiality, and pursue
          the facts.
        </p>
      </div>
    </div>

    <div class="about__side">
      <StatBadges />
      <blockquote class="about__quote">
        "Our goal is simple: to build a company clients can trust when the truth matters most."
      </blockquote>
    </div>
  </div>

  <details class="about__more">
    <summary class="about__toggle">
      <span class="about__toggle-label about__toggle-label--closed">Show more</span>
      <span class="about__toggle-label about__toggle-label--open">Show less</span>
      <svg class="about__toggle-icon" viewBox="0 0 14 12" aria-hidden="true">
        <path d="M1 1l6 10 6-10" fill="none" stroke="currentColor" stroke-width="1.2"></path>
      </svg>
    </summary>

    <div class="about__extra">
      <div class="about__bio about__bio--extra">
        <p class="about__lead about__lead--caps">More than an investigation</p>
        <p>
          {name} was created with a broader vision: to build a professional investigative resource
          that can serve not only individuals and families, but also law firms, attorneys,
          businesses, organizations, and the community.
        </p>
        <p>
          Together with her daughter, an attorney, Andrea has developed a collaborative network
          designed to connect investigative services with legal and professional resources when
          appropriate.
        </p>
        <p>
          This collaboration allows {name} to provide investigative support that can complement the
          work of attorneys and other professionals, including fact-finding, witness location,
          background research, surveillance, financial investigative support, evidence
          documentation, and other specialized investigative services.
        </p>
        <p>
          Our goal is simple: To help attorneys, organizations, businesses, families, and
          individuals obtain the information and investigative support they need to make informed
          decisions and address challenging circumstances with greater clarity.
        </p>
        <p class="about__lead about__lead--caps">Our commitment</p>
        <p>
          At {name}, we believe that professional investigation is about more than finding
          information.
        </p>
        <p>
          It is about knowing where to look, asking the right questions, recognizing what matters,
          documenting the facts, and handling sensitive information with discretion and integrity.
        </p>
      </div>

      <div class="about__photo">
        <Image
          src={aboutPhoto}
          alt={`${founder}, founder and Principal Private Investigator of ${name}`}
          widths={[406, 609, 812, 1145]}
          sizes="(min-width: 1549px) 26.2vw, 406px"
          loading="lazy"
        />
      </div>
    </div>
  </details>
</div>

<style>
  .about {
    --u: 1px;
    --s: 0.697;
    container-type: inline-size;
    /* Mobile: kicker a 29px del borde superior (Container:margin 419:1424). */
    padding: 1.8125rem 0 1.5rem;
  }

  .about__grid {
    width: min(calc(var(--u) * 404), 100% - 2.25rem);
    margin-inline: auto;
  }

  .about__main {
    display: contents;
  }

  .about__grid {
    display: flex;
    flex-direction: column;
  }

  /* Kicker (322:1341 / 419:1429): Inter Bold 16px, tracking 2.2px, dorado. */
  .about__kicker {
    order: 1;
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: calc(var(--u) * 16 * var(--s));
    line-height: 1.03;
    letter-spacing: 0.1375em;
    text-transform: uppercase;
    color: var(--color-gold);
    text-align: center;
  }

  /* Heading (322:1343 / 419:1431): Fraunces Medium; mobile 26px centrado en 342px. */
  .about__heading {
    order: 2;
    max-width: calc(var(--u) * 342);
    margin: 0 auto;
    padding-top: calc(var(--u) * 14);
    font-weight: 500;
    font-size: calc(var(--u) * 26);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-white);
    text-align: center;
  }

  /* En mobile los stats van entre el heading y la bio (Paragraph 419:1432). */
  .about__side {
    order: 3;
    padding-top: calc(var(--u) * 20);
  }

  .about__main .about__bio {
    order: 4;
  }

  /* Bio (322:1345): Inter 16px/24px blanco al 70%, 8px entre párrafos. */
  .about__bio p {
    margin: 0 0 calc(var(--u) * 8 * var(--s));
    font-size: calc(var(--u) * 16 * var(--s));
    line-height: calc(var(--u) * 24 * var(--s));
    color: rgba(255, 255, 255, 0.7);
  }

  .about__bio > .about__lead:first-child {
    padding-top: calc(var(--u) * 11);
  }

  /* "Meet Andrea Roa": Inter Medium #E9C37E; los subtítulos del texto extendido son
     Inter Bold en mayúsculas (mismo color). */
  .about__bio .about__lead {
    font-weight: 500;
    color: var(--color-gold-light);
  }

  .about__bio .about__lead--caps {
    font-weight: 700;
    text-transform: uppercase;
  }

  /* Cita y foto no existen en el frame mobile. */
  .about__quote {
    display: none;
  }

  .about__photo {
    display: none;
  }

  /* Toggle (Frame 41, 322:1447): "Show more" Inter 16px/25px #E9C37E + flecha de trazo
     1.2px a 14px; alineado al borde derecho. */
  .about__more {
    width: min(calc(var(--u) * 404), 100% - 2.25rem);
    margin-inline: auto;
  }

  .about__toggle {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 14 * var(--s));
    width: fit-content;
    margin-left: auto;
    padding-block: calc(var(--u) * 8);
    cursor: pointer;
    list-style: none;
    font-size: calc(var(--u) * 16 * var(--s));
    line-height: calc(var(--u) * 25 * var(--s));
    color: var(--color-gold-light);
  }

  .about__toggle::-webkit-details-marker {
    display: none;
  }

  .about__toggle:focus-visible {
    outline: 2px solid var(--color-gold-light);
    outline-offset: 4px;
  }

  .about__toggle-icon {
    width: calc(var(--u) * 13.3 * var(--s));
    height: calc(var(--u) * 11.5 * var(--s));
    transition: transform 0.2s ease;
  }

  .about__toggle-label--open,
  .about__more[open] .about__toggle-label--closed {
    display: none;
  }

  .about__more[open] .about__toggle-label--open {
    display: inline;
  }

  .about__more[open] .about__toggle-icon {
    transform: rotate(180deg);
  }

  .about__extra {
    width: 100%;
  }

  /* --- Desktop (≥1024px): medidas del frame de 1549px. --- */
  @media (min-width: 1024px) {
    .about {
      --u: max(1px, 100cqi / 1549);
      --s: 1;
      /* Section: 96px arriba; el toggle queda 20px sobre el borde inferior. */
      padding: calc(var(--u) * 96) 0 calc(var(--u) * 20);
    }

    .about__grid {
      width: min(calc(var(--u) * 1200), 100% - 3rem);
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: calc(var(--u) * 80);
      align-items: start;
    }

    .about__main {
      display: block;
    }

    .about__kicker {
      text-align: left;
    }

    .about__heading {
      max-width: calc(var(--u) * 388);
      margin: 0;
      padding-top: calc(var(--u) * 20);
      font-size: calc(var(--u) * 44);
      line-height: calc(var(--u) * 52.8);
      text-align: left;
    }

    .about__bio > .about__lead:first-child {
      padding-top: calc(var(--u) * 28);
    }

    .about__side {
      padding-top: calc(var(--u) * 56);
    }

    /* Cita (322:1444): 387px, fondo #0A1929 al 5%, borde izquierdo 2px dorado, padding
         16/20; texto Fraunces SemiBold Italic 15px/24px blanco. */
    .about__quote {
      display: block;
      width: calc(var(--u) * 387);
      /* 32px de margen + 25px de alto extra que tiene el contenedor del grid de stats
             en Figma (355px para celdas que suman 330). */
      margin: calc(var(--u) * 57) 0 0;
      padding: calc(var(--u) * 16) calc(var(--u) * 20);
      background: rgba(10, 25, 41, 0.05);
      border-left: 2px solid var(--color-gold);
      font-family: var(--font-display);
      font-weight: 600;
      font-style: italic;
      font-size: calc(var(--u) * 15);
      line-height: calc(var(--u) * 24);
      color: var(--color-white);
    }

    /* El toggle se alinea al borde derecho de la sección menos 32px (Section pad). */
    .about__more {
      width: auto;
      margin-inline: calc(var(--u) * 32);
    }

    /* En Figma el toggle (y=710) queda 26px por encima del final de la bio (y=736):
         está del lado derecho, así que no choca con el texto. */
    .about__toggle {
      margin-top: calc(var(--u) * -26);
      padding-block: 0;
    }

    /* Texto extendido (322:1210, 735px) + foto (322:1217, 406×487) en los extremos
         del contenedor de 1200px, 3px debajo del toggle. */
    .about__extra {
      width: min(calc(var(--u) * 1200), 100%);
      margin: calc(var(--u) * 3) auto 0;
      padding-bottom: calc(var(--u) * 37);
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: calc(var(--u) * 40);
    }

    .about__bio--extra {
      max-width: calc(var(--u) * 735);
    }

    .about__photo {
      display: block;
      flex-shrink: 0;
      width: calc(var(--u) * 406);
      /* Borde de 1px INSIDE con degradado vertical #B0803A (abajo) → #D2A967 (arriba). */
      padding: 1px;
      border-radius: 2px;
      background: linear-gradient(to top, #b0803a, #d2a967);
    }

    .about__photo :global(img) {
      display: block;
      width: 100%;
      height: calc(var(--u) * 485);
      object-fit: cover;
      border-radius: 1px;
    }
  }
</style>
