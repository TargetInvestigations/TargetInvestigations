---
import { Image } from 'astro:assets';
import StatBadges from './StatBadges.astro';
import aboutPhoto from '../images/about.png';
import { siteConfig } from '../config/site';
---

<div class="about">
  <div class="about__intro">
    <p class="about__kicker">About</p>
    <h2 class="about__heading">Built on one simple principle: the truth doesn't negotiate.</h2>
  </div>

  <div class="about__grid">
    <div class="about__text">
      <p class="about__lead">Meet {siteConfig.company.founder}</p>
      <p>
        For more than a decade, Andrea Roa has been dedicated to the private investigative
        profession, building her experience around one fundamental principle: when the truth
        matters, the facts matter.
      </p>
      <p>
        As the founder and Principal Private Investigator of {siteConfig.company.name}, Andrea
        brings a professional, discreet, and detail-oriented approach to every assignment. Her
        commitment is to provide clients with reliable information, carefully documented evidence,
        and investigative support they can trust when important decisions are at stake.
      </p>
      <p>
        Andrea understands that every investigation is different. Some involve deeply personal
        family matters. Others involve businesses, attorneys, financial concerns, insurance claims,
        or complex civil disputes. Regardless of the circumstances, her approach remains the same:
        listen carefully, investigate responsibly, protect confidentiality, and pursue the facts.
      </p>

      <details class="about__more">
        <summary>
          <span class="about__more-label about__more-label--closed">Show more</span>
          <span class="about__more-label about__more-label--open">Show less</span>
        </summary>
        <p class="about__lead">More Than an Investigation</p>
        <p>
          {siteConfig.company.name} was created with a broader vision: to build a professional
          investigative resource that can serve not only individuals and families, but also law
          firms, attorneys, businesses, organizations, and the community.
        </p>
        <p>
          Together with her daughter, an attorney, Andrea has developed a collaborative network
          designed to connect investigative services with legal and professional resources when
          appropriate. This collaboration allows {siteConfig.company.name} to provide investigative
          support that can complement the work of attorneys and other professionals, including
          fact-finding, witness location, background research, surveillance, financial investigative
          support, evidence documentation, and other specialized investigative services.
        </p>
        <p>
          Our goal is simple: to help attorneys, organizations, businesses, families, and
          individuals obtain the information and investigative support they need to make informed
          decisions and address challenging circumstances with greater clarity.
        </p>
        <p class="about__lead">Our Commitment</p>
        <p>
          At {siteConfig.company.name}, we believe that professional investigation is about more
          than finding information. It is about knowing where to look, asking the right questions,
          recognizing what matters, documenting the facts, and handling sensitive information with
          discretion and integrity.
        </p>
      </details>
    </div>

    <div class="about__stats">
      <StatBadges />
    </div>

    <blockquote class="about__quote">
      "Our goal is simple: to build a company clients can trust when the truth matters most."
    </blockquote>

    <div class="about__photo">
      <Image
        src={aboutPhoto}
        alt={`${siteConfig.company.founder}, founder and Principal Private Investigator of ${siteConfig.company.name}`}
        widths={[350, 500]}
        sizes="25vw"
        loading="lazy"
      />
    </div>
  </div>
</div>

<style>
  .about__intro {
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
    margin-bottom: 2.5rem;
  }

  .about__kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold);
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
  }

  .about__heading {
    font-size: 1.75rem;
  }

  .about__grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* En mobile Figma no muestra la foto de About (solo stats + bio); en desktop sí. */
  .about__stats {
    order: 1;
  }

  .about__text {
    order: 2;
  }

  .about__quote {
    order: 3;
  }

  .about__photo {
    display: none;
  }

  .about__text p {
    opacity: 0.85;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .about__lead {
    font-family: var(--font-display);
    font-weight: 600;
    opacity: 1 !important;
    color: var(--color-gold);
  }

  .about__more summary {
    cursor: pointer;
    color: var(--color-gold);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    list-style: none;
  }

  .about__more summary::-webkit-details-marker {
    display: none;
  }

  .about__more-label--open {
    display: none;
  }

  .about__more[open] .about__more-label--closed {
    display: none;
  }

  .about__more[open] .about__more-label--open {
    display: inline;
  }

  .about__quote {
    margin: 0;
    padding-left: 1rem;
    border-left: 2px solid var(--color-gold);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--color-cream);
  }

  .about__photo :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .about__intro {
      text-align: left;
      margin-inline: 0;
      max-width: none;
    }

    .about__heading {
      font-size: 2.75rem;
      font-weight: 600;
      max-width: 24rem;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }

    /* Columnas ~iguales (560px/560px con 80px de separación sobre un contenedor de
       1200px en Figma, nodo 322:1337) — no 2fr/1fr como estaba. La columna derecha
       apila stats → cita → foto (la foto solo aparece al expandir "Show more"). */
    .about__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-areas: 'text stats' 'text quote' 'text photo';
      gap: 1.5rem 5rem;
      align-content: start;
    }

    .about__text {
      grid-area: text;
    }

    .about__quote {
      grid-area: quote;
    }

    /* La foto solo aparece junto con el texto extra al abrir "Show more" (nodo
       322:1096 en Figma: el CHANGE_TO que revela el resto del bio también trae la
       foto) — antes se mostraba siempre, sin depender del estado del acordeón. */
    .about__photo {
      grid-area: photo;
      display: none;
    }

    .about__grid:has(.about__more[open]) .about__photo {
      display: block;
    }

    .about__stats {
      grid-area: stats;
    }
  }
</style>
