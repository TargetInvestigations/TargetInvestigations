---
/**
 * Panel 2×2 de stats de About (I322:1221;322:1348 desktop / 419:1436 mobile). Celdas de
 * 279×164 (#163155, padding 36/28) separadas por 2px de hueco — sin líneas doradas
 * entre celdas (el hueco deja ver el fondo de la sección). Valor Fraunces Medium 42px
 * dorado; etiqueta Inter SemiBold 14px crema; leyenda Inter Medium Italic 11px dorada
 * al 60%. La celda del mapa lleva la dirección (Inter SemiBold 14px/16px, caja de
 * ~123px) + leyenda a la izquierda y el contorno de Florida (89×83) a la derecha.
 *
 * Usa `--u` y `--s` de About.astro (mobile = desktop × 0.697, como en Figma).
 */
import { siteConfig } from '../config/site';
import floridaMap from '../icons/florida-map.svg?raw';

// En Figma (322:1371) la dirección lleva un salto de línea manual después de la primera
// ciudad ("Boca Raton," / "West Palm Beach, …").
const [firstPlace, ...otherPlaces] = siteConfig.company.coverageArea.split(', ');

const licenseLabel = siteConfig.company.licenseNumber
  ? `Licensed & Insured # ${siteConfig.company.licenseNumber}`
  : 'Licensed & Insured # A------';
---

<ul class="stat-badges">
  <li class="stat-badges__item stat-badges__item--map">
    <div class="stat-badges__address-block">
      <span class="stat-badges__address">
        {firstPlace},<br />
        {otherPlaces.join(', ')}
      </span>
      <span class="stat-badges__caption">Nationwide Florida</span>
    </div>
    <span class="stat-badges__map" aria-hidden="true" set:html={floridaMap} />
  </li>
  <li class="stat-badges__item">
    <span class="stat-badges__value">100%</span>
    <span class="stat-badges__label">Confidentiality</span>
    <span class="stat-badges__caption">No exceptions</span>
  </li>
  <li class="stat-badges__item">
    <span class="stat-badges__value">24h</span>
    <span class="stat-badges__label">Response Time</span>
    <span class="stat-badges__caption">Initial contact</span>
  </li>
  <li class="stat-badges__item">
    <span class="stat-badges__value">Class A</span>
    <span class="stat-badges__label">{licenseLabel}</span>
  </li>
</ul>

<style>
  .stat-badges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(var(--u) * 2 * var(--s));
  }

  .stat-badges__item {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-height: calc(var(--u) * 164 * var(--s));
    padding: calc(var(--u) * 36 * var(--s)) calc(var(--u) * 28 * var(--s));
    background-color: var(--color-navy-card);
  }

  .stat-badges__item--map {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  /* En Figma el texto mide 128px y casi toca el mapa (128 + 89 = 217 de 223 útiles). */
  .stat-badges__address-block {
    display: flex;
    flex-direction: column;
    flex: none;
    width: calc(var(--u) * 128 * var(--s));
  }

  .stat-badges__address {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: calc(var(--u) * 14 * var(--s));
    line-height: calc(var(--u) * 16 * var(--s));
    color: var(--color-cream);
  }

  .stat-badges__map {
    display: block;
    flex-shrink: 0;
    width: calc(var(--u) * 89 * var(--s));
  }

  .stat-badges__map :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .stat-badges__value {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: calc(var(--u) * 42 * var(--s));
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-gold);
  }

  .stat-badges__label {
    padding-top: calc(var(--u) * 8 * var(--s));
    font-family: var(--font-body);
    font-weight: 600;
    font-size: calc(var(--u) * 14 * var(--s));
    line-height: 1.5;
    color: var(--color-cream);
  }

  .stat-badges__caption {
    white-space: nowrap;
    padding-top: calc(var(--u) * 4 * var(--s));
    font-family: var(--font-body);
    font-weight: 500;
    font-style: italic;
    font-size: calc(var(--u) * 11 * var(--s));
    line-height: 1.5;
    letter-spacing: 0.1em;
    color: rgba(184, 147, 90, 0.6);
  }
</style>
