---
import Button from './Button.astro';
import { siteConfig } from '../config/site';

const phoneDisplay = siteConfig.contact.phoneDisplay ?? '(xxx) xxx-xxxx';
const email = siteConfig.contact.email ?? 'xxx@targetinvestigations.com';
---

<div class="contact-cta">
  <h2 class="contact-cta__heading">Need clarity about your situation?</h2>
  <p class="contact-cta__lead">
    Every engagement begins with a confidential conversation. No commitment, no records retained
    until you decide to proceed.
  </p>

  <Button href="#contact" variant="solid">
    Request a Confidential Consultation
  </Button>

  <div class="contact-cta__details">
    <div>
      <span class="contact-cta__label">Direct Line</span>
      <span>{phoneDisplay}</span>
    </div>
    <div>
      <span class="contact-cta__label">Confidential Email</span>
      <span>{email}</span>
    </div>
  </div>
</div>

<style>
  .contact-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .contact-cta__heading {
    font-size: 1.75rem;
  }

  .contact-cta__lead {
    opacity: 0.85;
    max-width: 32rem;
  }

  .contact-cta__details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  .contact-cta__label {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.75rem;
    color: var(--color-gold);
    margin-bottom: 0.15rem;
  }

  @media (min-width: 768px) {
    .contact-cta__details {
      flex-direction: row;
      gap: 3rem;
    }
  }
</style>
