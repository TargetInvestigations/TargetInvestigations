---
/**
 * CTA final "Need clarity about your situation?" (nodo 53:400 en Figma). Reutiliza el
 * mismo ícono de marca del Header/Hero (logo-mark.svg) y el mismo botón con swap a
 * WhatsApp en hover (WhatsAppCta.astro, componente real `53:39` — idéntico al del
 * Hero, solo que aquí el texto/botón es más grande, nodo `430:2312`).
 */
import WhatsAppCta from './WhatsAppCta.astro';
import logoMark from '../icons/logo-mark.svg?raw';
import { siteConfig } from '../config/site';

const phoneDisplay = siteConfig.contact.phoneDisplay ?? '(xxx) xxx-xxxx';
const email = siteConfig.contact.email ?? 'xxx@targetinvestigations.com';
---

<div class="contact-cta">
  <span class="contact-cta__icon" aria-hidden="true" set:html={logoMark} />

  <h2 class="contact-cta__heading">Need clarity about your situation?</h2>
  <p class="contact-cta__lead">
    Every engagement begins with a confidential conversation. No commitment, no records retained
    until you decide to proceed.
  </p>

  <WhatsAppCta class="contact-cta__cta" />

  <div class="contact-cta__details">
    <div class="contact-cta__detail">
      <span class="contact-cta__label">Direct Line</span>
      <span class="contact-cta__value">{phoneDisplay}</span>
    </div>
    <span class="contact-cta__divider" aria-hidden="true"></span>
    <div class="contact-cta__detail">
      <span class="contact-cta__label">Confidential Email</span>
      <span class="contact-cta__value">{email}</span>
    </div>
  </div>
</div>

<style>
  .contact-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-cta__icon {
    display: block;
    width: 3.25rem;
    margin-bottom: 1.5rem;
  }

  .contact-cta__icon :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  .contact-cta__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.85rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-cream);
    margin-bottom: 1.25rem;
  }

  .contact-cta__lead {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-cream);
    opacity: 0.55;
    max-width: 28rem;
    margin-bottom: 1.75rem;
  }

  .contact-cta__details {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .contact-cta__detail {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .contact-cta__divider {
    align-self: stretch;
    width: 1px;
    background: rgba(184, 147, 90, 0.2);
  }

  .contact-cta__label {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.625rem;
    color: var(--color-gold);
    opacity: 0.6;
  }

  .contact-cta__value {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1rem;
    color: var(--color-cream);
  }

  /* Tamaño del CTA en esta sección (nodo 430:2312 en Figma) — más grande que el del
     Hero. :global() porque el <a> real lo renderiza WhatsAppCta.astro, no este
     archivo (ver memoria "astro-scoped-css-child-component-gotcha"). */
  :global(.contact-cta__cta) {
    padding: 1.15rem 2.5rem;
  }

  :global(.contact-cta__cta .whatsapp-cta__face) {
    font-size: 1.15rem;
  }

  @media (min-width: 768px) {
    .contact-cta__heading {
      /* 3rem en vez de los 3.2rem (51.2px) medidos en el nodo: con el padding-inline
         del Container (1.5rem) el ancho útil real es ~752px, apenas por debajo de los
         757px que ocupa el texto a 51.2px en Figma, y se parte en dos líneas cuando en
         el diseño va en una sola — se redujo lo mínimo necesario para que entre. */
      font-size: 3rem;
    }

    .contact-cta__lead {
      font-size: 1.0625rem;
      max-width: 32rem;
    }

    .contact-cta__details {
      gap: 3rem;
    }
  }
</style>
